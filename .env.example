# Salin menjadi .env lalu isi dengan connection string Supabase (Project Settings → Database → Connection pooling).
# Runtime aplikasi: transaction pooler (port 6543).
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=no-verify"
# Migrasi Prisma: session pooler (port 5432).
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"
# Database untuk unit test: schema terpisah "test" di database yang sama.
TEST_DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify&schema=test"
